// Exe and window icon (resource 1), generated by tools/logo/gen.py.
1 ICON "lemonstudio.ico"
1 24 "lemonstudio.manifest"

#include "product-version.h"

1 VERSIONINFO
 FILEVERSION ML_FILE_VERSION
 PRODUCTVERSION ML_FILE_VERSION
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Michael Lane\0"
            VALUE "FileDescription", "ML Studio\0"
            VALUE "ProductName", "ML Studio\0"
            VALUE "FileVersion", ML_PRODUCT_VERSION
            VALUE "ProductVersion", ML_PRODUCT_VERSION
            VALUE "OriginalFilename", "ML Studio.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
